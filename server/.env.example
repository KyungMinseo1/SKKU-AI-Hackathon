# ASKKUP server settings (copy to .env). Run the server from server/.
DATA_DIR=./data
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_DAYS=7

OPENAI_API_KEY=
GEMINI_API_KEY=

# QUESTION role: student question refine/filter (vision)
QUESTION_LLM_PROVIDER=openai
QUESTION_LLM_MODEL=gpt-6-luna
QUESTION_LLM_BASE_URL=
QUESTION_LLM_API_KEY=
QUESTION_LLM_REASONING_EFFORT=low
QUESTION_LLM_SUPPORTS_IMAGES=true

# CURRICULUM role: syllabus parsing, week concept generation, question classification
CURRICULUM_LLM_PROVIDER=openai
CURRICULUM_LLM_MODEL=gpt-6-luna
CURRICULUM_LLM_BASE_URL=
CURRICULUM_LLM_API_KEY=
CURRICULUM_LLM_REASONING_EFFORT=

# EMBEDDING: openai | gemini | vllm | none
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Gemini example ---
# QUESTION_LLM_PROVIDER=gemini
# QUESTION_LLM_MODEL=gemini-3.8-flash
# CURRICULUM_LLM_PROVIDER=gemini
# CURRICULUM_LLM_MODEL=gemini-3.8-flash
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_API_KEY=...

# --- vLLM example (OpenAI-compatible servers) ---
# QUESTION_LLM_PROVIDER=vllm
# QUESTION_LLM_BASE_URL=http://localhost:8001/v1
# QUESTION_LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# CURRICULUM_LLM_PROVIDER=vllm
# CURRICULUM_LLM_BASE_URL=http://localhost:8001/v1
# CURRICULUM_LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# EMBEDDING_PROVIDER=vllm
# EMBEDDING_BASE_URL=http://localhost:8002/v1
# EMBEDDING_MODEL=BAAI/bge-m3
